# Copy to .env for local development. Never commit real values.

# --- AI (required for the coach, voice check and committee) ---
ANTHROPIC_API_KEY=

# --- Database (production only; local dev uses PGlite in data/pglite) ---
# Neon "pooled" connection string (host contains -pooler)
DATABASE_URL=
# Neon direct (unpooled) connection string, used for migrations
DATABASE_URL_UNPOOLED=

# --- Auth (production only) ---
# 32+ random characters, generate once and keep it stable: openssl rand -hex 32
BETTER_AUTH_SECRET=
# Skip login locally (never set in production)
# AUTH_DISABLED=true

# --- Vercel scheduled jobs (production) ---
# Random value; Vercel sends it with cron requests
CRON_SECRET=

# --- Telegram companion (optional, "Should" feature S3) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=

# Custom health check message
PING_MESSAGE=pong
